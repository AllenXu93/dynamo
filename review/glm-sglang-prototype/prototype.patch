+        }
+        tools = convert_tools(request["tools"])
+        parser, reasoning = create_parsers(
+            request, tool_call_parser_name="glm47", reasoning_parser_name="glm45"
+        )
+        post = SglangStreamingPostProcessor(
+            tokenizer=None,
+            tool_call_parser=parser,
+            reasoning_parser=reasoning,
+            sglang_tools=tools,
+            tool_call_parser_name="glm47",
+        )
+        step = chunk_size or len(text)
+        chunks = [text[offset : offset + step] for offset in range(0, len(text), step)]
+        choices = [
+            post.process_output({"text": chunk, "token_ids": []}) for chunk in chunks
+        ]
+        choices.append(
+            post.process_output({"text": "", "token_ids": [], "finish_reason": "stop"})
+        )
+        deltas = [choice["delta"] for choice in choices if choice]
+        assert "".join(delta.get("content", "") for delta in deltas) == expected_content
+        assert (
+            "".join(delta.get("reasoning_content", "") for delta in deltas)
+            == expected_reasoning
+        )
+        arguments = "".join(
+            call["function"].get("arguments", "")
+            for delta in deltas
+            for call in delta.get("tool_calls", [])
+        )
+        assert arguments == expected_args
+        assert choices[-1]["finish_reason"] == "tool_calls"
 
 
