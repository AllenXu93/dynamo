new file mode 100644
--- /dev/null
+++ b/components/src/dynamo/frontend/tests/_glm_grammar_checks.py
@@ -0,0 +1,113 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""CPU checks for the SGLang reasoning gate and response JSON grammar.
+
+The byte vocabulary is a deterministic test tokenizer, not a model tokenizer.
+The frontend projection, worker projection, grammar compiler and reasoning gate
+are the production implementations.
+"""
+
+import json
+
+
+def compile_glm_response_grammar(schema):
+    import xgrammar as xgr
+    from sglang.srt.constrained.reasoner_grammar_backend import ReasonerGrammarBackend
+    from sglang.srt.constrained.xgrammar_backend import XGrammarGrammarBackend
+    from sglang.srt.parser.reasoning_parser import ReasoningParser
+
+    from dynamo.frontend.sglang_prepost import (
+        _guided_output_requires_reasoning,
+        build_response_format_guided_decoding,
+    )
+    from dynamo.frontend.sglang_processor import _build_dynamo_preproc
+    from dynamo.sglang.request_handlers.handler_base import BaseWorkerHandler
+
+    class ByteTokenizer:
+        def encode(self, text, **kwargs):
+            return list(text.encode("utf-8"))
+
+        def decode(self, token_ids, **kwargs):
+            return bytes(token_ids).decode("utf-8", errors="replace")
+
+        def init_xgrammar(self):
+            return (
+                xgr.TokenizerInfo(
+                    [bytes([index]) for index in range(256)] + [b"<eos>"],
+                    stop_token_ids=[256],
+                ),
+                None,
+            )
+
+    request = {
+        "model": "test-glm",
+        "response_format": {
+            "type": "json_schema",
+            "json_schema": {"name": "weather", "strict": True, "schema": schema},
+        },
+    }
+    guided = build_response_format_guided_decoding(request)
+    require_reasoning = _guided_output_requires_reasoning(request, True, "glm45")
+    assert require_reasoning is True
+    preproc = _build_dynamo_preproc(
+        request,
+        [],
+        request["model"],
+        [256],
+        guided,
+        require_reasoning=require_reasoning,
+    )
+    sampling = BaseWorkerHandler._get_guided_decoding_params(
+        preproc["sampling_options"]["guided_decoding"]
+    )
+    assert json.loads(sampling["json_schema"]) == schema
+    tokenizer = ByteTokenizer()
+    backend = ReasonerGrammarBackend(
+        XGrammarGrammarBackend(tokenizer, 257, [256]),
+        ReasoningParser("glm45", stream_reasoning=True, force_reasoning=True),
+        tokenizer,
+    )
+    grammar = backend._init_value_dispatch(
+        ("json", sampling["json_schema"]), preproc["require_reasoning"]
+    )
+    assert grammar is not None
+    return grammar, tokenizer, preproc
+
+
+def accepts_glm_response(grammar, tokenizer, chunks):
+    """Require both acceptance of every token and a legal terminal EOS."""
+    candidate = grammar.copy()
+    for chunk in chunks:
+        for token_id in tokenizer.encode(chunk):
+            if candidate.is_terminated():
+                return False
+            try:
+                candidate.accept_token(token_id)
+            except ValueError:
+                return False
+    try:
+        candidate.accept_token(256)
+    except ValueError:
+        return False
+    return candidate.is_terminated()
+
+
+def verify_glm_response_grammar(schema, accepted, rejected):
+    """Check the authored Unicode response at every character split."""
+    grammar, tokenizer, preproc = compile_glm_response_grammar(schema)
+    assert accepts_glm_response(grammar, tokenizer, [accepted])
+    for split in range(len(accepted) + 1):
+        assert accepts_glm_response(
+            grammar, tokenizer, [accepted[:split], accepted[split:]]
+        ), f"grammar rejected character split {split}"
+    for index, text in enumerate(rejected):
+        assert not accepts_glm_response(
+            grammar, tokenizer, [text]
+        ), f"grammar accepted invalid probe {index}"
+    return {
+        "accepted_checks": len(accepted) + 2,
+        "rejected_checks": len(rejected),
+        "require_reasoning": preproc["require_reasoning"],
+        "tokenizer": "deterministic UTF-8 byte vocabulary; no model weights",
+    }
